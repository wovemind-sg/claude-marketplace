#!/usr/bin/env bash
# ntfy-send -s <server> <message> [-t title] [-p priority] [-T tags] [-o topic]
#
# -s server    ntfy server URL, required (e.g. https://ntfy.sh)
# message      any string, required
# -t title     any string
# -p priority  1|min, 2|low, 3|default, 4|high, 5|urgent
# -T tags      comma-separated, e.g. warning,skull (see https://docs.ntfy.sh/emojis/)
# -o topic     default: claude
#
# If ~/.ntfy exists, its contents are sent as a Bearer token (self-hosted servers
# with auth); otherwise no auth header is sent (public ntfy.sh needs none).
# Options may come before or after the message.
set -euo pipefail

server=""
topic="claude"
token_file="$HOME/.ntfy"
message=""
title=""
priority=""
tags=""

usage() { echo "usage: ntfy-send -s <server> <message> [-t title] [-p priority] [-T tags] [-o topic]" >&2; exit "${1:-1}"; }

[ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] && usage 0

while [ $# -gt 0 ]; do
  OPTIND=1
  while getopts "s:t:p:T:o:" opt; do
    case "$opt" in
      s) server="$OPTARG" ;;
      t) title="$OPTARG" ;;
      p) priority="$OPTARG" ;;
      T) tags="$OPTARG" ;;
      o) topic="$OPTARG" ;;
      *) usage ;;
    esac
  done
  shift $((OPTIND - 1))
  if [ $# -gt 0 ]; then
    [ -z "$message" ] || usage
    message="$1"; shift
  fi
done

[ -n "$server" ] && [ -n "$message" ] || usage
# Only http(s) servers and plain topic names, so neither can become a curl option, another scheme or another path.
case "$server" in http://*|https://*) ;; *) echo "ntfy-send: server must start with http:// or https://" >&2; exit 1 ;; esac
[[ "$topic" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || { echo "ntfy-send: topic may only contain letters, digits, _ and - (max 64)" >&2; exit 1; }
for v in "$title" "$priority" "$tags"; do  # a line break would inject extra headers
  [[ "$v" != *[$'\r\n']* ]] || { echo "ntfy-send: -t, -p and -T must be one line" >&2; exit 1; }
done

args=(-sSf)  # -f: exit non-zero on an HTTP error (bad token, rate limit)
auth=""
if [ -f "$token_file" ]; then
  case "$server" in http://*) echo "ntfy-send: warning: sending the ~/.ntfy token over plain http" >&2 ;; esac
  # Header read from stdin, so the token never appears in the process list.
  auth="Authorization: Bearer $(cat "$token_file")"
  args+=(-H @-)
fi
[ -n "$title" ] && args+=(-H "Title: $title")
[ -n "$priority" ] && args+=(-H "Priority: $priority")
[ -n "$tags" ] && args+=(-H "Tags: $tags")

# --data-raw: a message starting with @ is sent as text, not read from a local file.
printf '%s\n' "$auth" | curl "${args[@]}" --data-raw "$message" "${server%/}/$topic"
echo
